# SKILL: msad-dev-epic
# Purpose: End-to-end epic execution with subagent orchestration

title = "MSAD Developer — Epic Execution"
description = "Discovers tasks, PRs, identifies gaps, dispatches subagents, executes work, reports results"
icon = "🚀"
category = "MSAD Development"

# Trigger patterns
[triggers]
slash_command = "msad-dev-epic"
example_invocation = "/msad-dev-epic DDIDNS-7732"
accepts_jira_id = true

# Input parameters
[inputs]
epic_id = { type = "string", required = true, pattern = "DDIDNS-\\d+", example = "DDIDNS-7732" }
phase = { type = "string", required = false, default = "1", options = ["1", "2", "all"], description = "Which epic phase(s) to execute" }
mode = { type = "string", required = false, default = "auto", options = ["auto", "dry-run", "real"], description = "Execution mode" }

# Dependencies
[dependencies]
requires_atlassian_mcp = true
requires_github_cli = true
requires_docker = true
uses_subagents = ["msad-backend-dev", "msad-code-review", "claude"]

# Output
[output]
format = "structured report"
includes = ["epic summary", "per-PR status", "per-task status", "consolidated metrics", "next steps"]

# Metadata
[metadata]
authors = ["Seshachalam Malisetti"]
created = "2026-08-13"
updated = "2026-08-13"
status = "new"
maturity = "beta"
estimated_time = "15-30 minutes depending on work volume"
